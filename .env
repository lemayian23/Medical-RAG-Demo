# ============================================================
# Medical RAG Demo - Environment Variables
# ============================================================

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ARTICLE_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# FAISS Paths
FAISS_INDEX_PATH=./data/index/faiss_index.bin
METADATA_PATH=./data/index/metadata.pkl

# Ollama
OLLAMA_MODEL=llama3.2:1b

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/rag.db

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.5

# Critic Retries
MAX_CRITIC_RETRIES=2

# ============================================================
# OCR Configuration (NEW)
# ============================================================

# Tesseract path (Windows)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Upload directories
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# OCR Settings
OCR_LANGUAGE=eng  # eng, swa, or eng+swa
OCR_DPI=300

TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe