# ============================================================
# Medical RAG Demo - Environment Variables
# ============================================================

# Embedding Model (MedCPT - NIH trained)
EMBEDDING_MODEL_NAME=MedCPT/Query-Encoder
ARTICLE_EMBEDDING_MODEL_NAME=MedCPT/Article-Encoder

# FAISS Index Paths
FAISS_INDEX_PATH=./data/index/faiss_index.bin
METADATA_PATH=./data/index/metadata.pkl

# LLM (Ollama - runs locally)
OLLAMA_MODEL=mistral:7b-instruct-v0.2-q4_0

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/rag.db